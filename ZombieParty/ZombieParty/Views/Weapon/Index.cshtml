@model IEnumerable<ZombieParty.Models.Weapon>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Force</th>
            <th>Price</th>
            <th>Created Date</th>
            <th>Image</th>
            <th>Qty</th>
            <th>Qty Bought</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>@item.Force</td>
                <td>@item.Price</td>
                <td>@item.CreatedDate</td>
                <td>@item.ImageUrl</td>
                <td>@item.Qty</td>
                <td>@item.QtyBought</td>
            </tr>
        }
    </tbody>
</table>